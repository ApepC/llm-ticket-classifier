# --- SECRETS & ENV (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account.json
token.json
azure-credentials.json
openai_key.txt
anthropic_key.txt

# --- PYTHON ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
build/
dist/
.eggs/

# --- TESTING & LINTING ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- LLM & MODEL ARTIFACTS ---
# Large model files (will break GitHub push)
models/**/*.bin
models/**/*.pth
models/**/*.pt
models/**/*.onnx
models/**/*.safetensors
models/**/*.ckpt
*.pkl
*.pickle
*.joblib
.model_cache/
.huggingface/
.cache/

# --- EXPERIMENT TRACKING ---
wandb/
mlruns/
lightning_logs/
runs/
outputs/

# --- VECTOR STORES & DBs ---
.chroma/
chroma_db/
faiss_index/
*.faiss
*.sqlite
*.sqlite3
*.db

# --- DATA ---
# Ignore raw/private data but keep committed samples
data/raw/
data/private/
datasets/
*.parquet
*.arrow
*.large.csv

# Allow sanitized samples (comments must be on their own line!)
!data/samples/
!data/samples/**
!tests/fixtures/**

# --- NOTEBOOKS ---
# Use nbstripout to strip outputs instead of ignoring notebooks entirely
.ipynb_checkpoints/

# --- LOGS ---
*.log
logs/

# --- STREAMLIT ---
.streamlit/secrets.toml

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Thumbs.db:encryptable
__MACOSX/

# --- JUNK ---
*.bak
*.tmp
